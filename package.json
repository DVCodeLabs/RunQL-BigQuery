{
  "name": "runql-bigquery",
  "displayName": "RunQL BigQuery Connector",
  "description": "Optional BigQuery connector for RunQL.",
  "publisher": "runql",
  "icon": "media/icon.png",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
